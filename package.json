{
  "name": "tutor-pay",
  "version": "0.1.0",
  "private": true,
  "description": "TutorPay — 강사 배정·급여정산 관리 웹앱",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify-calc.ts",
    "start:prod": "tsx scripts/migrate.ts && next start -p 3000",
    "test:actions": "tsx -r ./scripts/test/shim.cjs scripts/test/actions.test.ts",
    "db:extract": "python3 scripts/extract_from_sheet.py"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "~15.5.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  }
}
