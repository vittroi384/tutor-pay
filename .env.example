# ---- 데이터베이스 ----
DATABASE_URL=postgres://tutorpay:tutorpay@localhost:5432/tutorpay
DB_PASSWORD=tutorpay

# ---- 로그인 ----
# 로컬 개발/검토용: true 로 두면 로그인 없이 "로컬 관리자"로 동작 (운영에서는 반드시 false)
AUTH_DISABLED=true
# `npx auth secret` 또는 `openssl rand -base64 32` 로 생성
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 로그인을 허용할 관리자 구글 이메일(쉼표 구분). 첫 로그인 시 자동으로 admin 사용자로 등록됨
ALLOWED_EMAILS=admin1@example.com,admin2@example.com
# 배포 도메인 (Caddy·NextAuth 공용)
DOMAIN=tutorpay.example.com
# 보조 도메인(선택) — 비우면 기존 DuckDNS 주소가 기본값으로 함께 서비스됩니다
# DOMAIN2=
# AUTH_URL 은 docker-compose 가 DOMAIN 값으로 자동 구성합니다 (별도 설정 불필요)
AUTH_TRUST_HOST=true

TZ=Asia/Seoul
